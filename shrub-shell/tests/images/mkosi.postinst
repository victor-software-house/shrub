#!/bin/bash
set -euo pipefail

SHRUB_BINARY="${SRCDIR}/shrub-target/${SHRUB_PROFILE}/shrub"

if [[ ! -f "${SHRUB_BINARY}" ]]; then
    echo "error: shrub binary not found at: ${SHRUB_BINARY}" >&2
    echo "hint: run 'cargo build --${SHRUB_PROFILE}' first, or override with:" >&2
    echo "  mkosi --environment=SHRUB_PROFILE=debug build" >&2
    exit 1
fi

# Install the pre-built shrub binary
install -Dm755 "${SHRUB_BINARY}" "${BUILDROOT}/usr/bin/shrub"

# Register shrub as a valid login shell
grep -qxF /usr/bin/shrub "${BUILDROOT}/etc/shells" 2>/dev/null \
    || echo /usr/bin/shrub >> "${BUILDROOT}/etc/shells"

# Make shrub available as /bin/sh and as /bin/bash
ln -sf shrub "${BUILDROOT}/usr/bin/sh"
ln -sf shrub "${BUILDROOT}/usr/bin/bash"
